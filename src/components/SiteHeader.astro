---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { fade } from "astro:transitions";

interface NavItem {
  label: string;
  href: string;
  external?: boolean;
  className?: string;
}

interface Props {
  locale: "ru" | "en";
  alternateHref: string;
  languageLabel: string;
  navAria?: string;
  navItems?: NavItem[];
  navClass?: string;
  appHeader?: boolean;
  shellClass?: string;
  backHref?: string;
  backLabel?: string;
  brandLabel?: string;
  brandHref?: string;
  brandIcon?: ImageMetadata;
  brandAria?: string;
}

const {
  locale,
  alternateHref,
  languageLabel,
  navAria,
  navItems = [],
  navClass,
  appHeader = false,
  shellClass,
  backHref,
  backLabel,
  brandLabel,
  brandHref = "#",
  brandIcon,
  brandAria,
} = Astro.props;
const HeaderContainer = appHeader ? "div" : "header";
const HeaderShell = appHeader ? "header" : "div";
---

<HeaderContainer class={appHeader ? "site-app-header-container" : "floating-header"}>
  <HeaderShell
    class:list={["site-header-shell", appHeader ? "site-app-header" : "portfolio-header", shellClass]}
    transition:name="site-header"
    transition:animate={fade({ duration: "0.18s" })}
  >
    {backHref || brandLabel ? (
      <div class="site-header-start" transition:name="site-header-content" transition:animate={fade({ duration: "0.18s" })}>
        {backHref && (
          <a
            class="site-back-button site-nav-link"
            href={backHref}
            aria-label={backLabel}
            title={backLabel}
          >
            <svg class="site-back-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14.5 5.5 8 12l6.5 6.5" />
            </svg>
          </a>
        )}
        {brandLabel && (
          <a class:list={["site-header-brand", { "site-header-brand-with-icon": brandIcon }]} href={brandHref} aria-label={brandAria}>
            {brandIcon && (
              <Image src={brandIcon} alt="" widths={[68, 102, 136]} sizes="(max-width: 680px) 31px, 34px" format="webp" quality={100} loading="eager" decoding="async" />
            )}
            <span>{brandLabel}</span>
          </a>
        )}
        {navItems.length > 0 && (
          <nav class:list={["site-header-nav", navClass]} aria-label={navAria}>
            {navItems.map((item) => (
              <a
                class:list={["site-nav-link", item.className]}
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noreferrer" : undefined}
              >
                {item.label}
                {item.external && <span aria-hidden="true"> ↗</span>}
              </a>
            ))}
          </nav>
        )}
      </div>
    ) : (
      <nav class:list={["site-header-start", "site-header-nav", navClass]} aria-label={navAria} transition:name="site-header-content" transition:animate={fade({ duration: "0.18s" })}>
        {navItems.map((item) => (
          <a
            class:list={["site-nav-link", item.className]}
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noreferrer" : undefined}
          >
            {item.label}
            {item.external && <span aria-hidden="true"> ↗</span>}
          </a>
        ))}
      </nav>
    )}

    <a
      class="site-language-switch site-header-end"
      href={alternateHref}
      hreflang={locale === "ru" ? "en" : "ru"}
    >
      {languageLabel}
    </a>
  </HeaderShell>
</HeaderContainer>
