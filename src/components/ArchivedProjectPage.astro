---
import "../styles/typography.css";
import "../styles/global.css";
import "../styles/site-ui.css";
import "../styles/project-detail.css";
import { Image } from "astro:assets";
import { ClientRouter, fade } from "astro:transitions";

import SiteHeader from "./SiteHeader.astro";
import favicon from "../assets/favicon.png";
import netliphyImage from "../assets/Netliphy.png";
import otpHubImage from "../assets/OTPHubMac.png";
import covidImage from "../assets/covid.png";

interface Props {
  locale?: "ru" | "en";
  project: "netliphy" | "otphub" | "covid-dashboard";
}

const { locale = "ru", project } = Astro.props;
const isRu = locale === "ru";

const projects = {
  netliphy: {
    slug: "netliphy",
    image: netliphyImage,
    repoUrl: "https://github.com/lisindima/Netliphy",
    landingRepoUrl: "https://github.com/lisindima/NetliphyLanding",
    themeClass: "project-netliphy",
    ru: {
      title: "Netliphy",
      metaTitle: "Netliphy — архивный проект Дмитрия Лисина",
      description: "Netliphy — SwiftUI-клиент для управления сайтами Netlify на iPhone, iPad и Mac.",
      eyebrow: "SwiftUI · Netlify · 2021–2022",
      status: "Архивный проект",
      lead: "Нативный клиент для управления сайтами на Netlify с устройств Apple — сайты, деплои, логи, Functions, уведомления и WidgetKit.",
      storyTitle: "Netlify без браузера.",
      story: "Netliphy объединял основные инструменты Netlify в нативном интерфейсе для устройств Apple. Приложение работало с сайтами и командами, историей деплоев и логами, usage, plugins, Functions, формами, environment variables и файлами. Для последнего деплоя был отдельный WidgetKit-виджет, а статусы сборок можно было отслеживать через уведомления.",
      periodLabel: "Период",
      period: "2021–2022",
      platformLabel: "Платформы",
      platform: "iPhone · iPad · Mac Catalyst",
      stackLabel: "Стек",
      stack: "SwiftUI · Netlify API · WidgetKit",
      featuresTitle: "Возможности.",
      featuresText: "Основные сценарии, реализованные в приложении.",
      features: [
        ["01", "Сайты и команды", "Список Netlify-сайтов и команд, профиль аккаунта и детальная информация по каждому сайту."],
        ["02", "Деплои и логи", "История сборок, детали деплоя, действия над ним и просмотр deploy logs."],
        ["03", "Инструменты сайта", "Usage, плагины, Functions, формы, environment variables и файлы в одном нативном интерфейсе."],
        ["04", "Виджет и уведомления", "WidgetKit для статуса последнего деплоя и настраиваемые уведомления по состояниям сборки."],
      ],
      archiveTitle: "Проект завершён.",
      archiveText: "Netliphy больше не поддерживается и публичная версия приложения недоступна. Исходный код приложения и отдельный репозиторий лендинга остаются открытыми на GitHub.",
      repoLabel: "Исходный код",
      landingLabel: "Лендинг",
      back: "Назад к проектам",
      navAbout: "О проекте",
      navFeatures: "Возможности",
      navAria: "Навигация по проекту Netliphy",
      language: "EN",
      screenshotLabel: "Интерфейс Netliphy",
    },
    en: {
      title: "Netliphy",
      metaTitle: "Netliphy — archived project by Dmitriy Lisin",
      description: "Netliphy — a SwiftUI client for managing Netlify sites from iPhone, iPad, and Mac.",
      eyebrow: "SwiftUI · Netlify · 2021–2022",
      status: "Archived project",
      lead: "A native client for managing Netlify sites across Apple devices — sites, deploys, logs, Functions, notifications, and WidgetKit.",
      storyTitle: "Netlify without the browser.",
      story: "Netliphy brought core Netlify tools into a native Apple-platform interface. The app covered sites and teams, deploy history and logs, usage, plugins, Functions, forms, environment variables, and files. A WidgetKit extension showed the latest deploy status, while configurable notifications tracked build states.",
      periodLabel: "Period",
      period: "2021–2022",
      platformLabel: "Platforms",
      platform: "iPhone · iPad · Mac Catalyst",
      stackLabel: "Stack",
      stack: "SwiftUI · Netlify API · WidgetKit",
      featuresTitle: "Capabilities.",
      featuresText: "Core workflows implemented in the app.",
      features: [
        ["01", "Sites & teams", "Browse Netlify sites and teams, account details, and per-site information."],
        ["02", "Deploys & logs", "Build history, deploy details, deploy actions, and deployment logs."],
        ["03", "Site tooling", "Usage, plugins, Functions, forms, environment variables, and files in one native interface."],
        ["04", "Widget & notifications", "A WidgetKit extension for latest deploy status plus configurable deploy notifications."],
      ],
      archiveTitle: "Project completed.",
      archiveText: "Netliphy is no longer maintained and the public app is unavailable. The application source and a separate landing-page repository remain available on GitHub.",
      repoLabel: "Source code",
      landingLabel: "Landing",
      back: "Back to projects",
      navAbout: "About",
      navFeatures: "Features",
      navAria: "Netliphy project navigation",
      language: "RU",
      screenshotLabel: "Netliphy interface",
    },
  },
  otphub: {
    slug: "otphub",
    image: otpHubImage,
    repoUrl: "https://github.com/lisindima/OTPHub",
    landingRepoUrl: "https://github.com/lisindima/OTPHubLanding",
    themeClass: "project-otphub",
    ru: {
      title: "OTPHub",
      metaTitle: "OTPHub — архивный проект Дмитрия Лисина",
      description: "OTPHub — SwiftUI-приложение для TOTP и HOTP на iOS и macOS.",
      eyebrow: "SwiftUI · Security · 2021",
      status: "Архивный проект",
      lead: "Генератор одноразовых паролей для iOS и macOS с TOTP/HOTP, QR-настройкой, синхронизируемым Keychain и резервными копиями.",
      storyTitle: "2FA как нативное приложение.",
      story: "OTPHub генерировал TOTP- и HOTP-коды на iOS и macOS. Для аккаунтов настраивались тип OTP, длина кода, период и алгоритм хэширования. Настройку можно было импортировать из стандартного otpauth:// QR-кода, данные хранились в синхронизируемом Keychain, а база поддерживала экспорт и импорт резервной копии.",
      periodLabel: "Период",
      period: "2021",
      platformLabel: "Платформы",
      platform: "iOS · macOS",
      stackLabel: "Стек",
      stack: "SwiftUI · Keychain · TOTP/HOTP",
      featuresTitle: "Возможности.",
      featuresText: "Основные сценарии генератора одноразовых паролей.",
      features: [
        ["01", "TOTP и HOTP", "Временные и счётчиковые OTP-коды, настраиваемая длина, период и алгоритм хэширования."],
        ["02", "QR onboarding", "Сканирование стандартных otpauth:// QR-кодов и автоматическое заполнение параметров аккаунта."],
        ["03", "Keychain sync", "Аккаунты хранились в синхронизируемом Keychain и использовались общей моделью приложения."],
        ["04", "Backup", "Экспорт и импорт отдельного backup-файла для переноса аккаунтов между устройствами."],
      ],
      archiveTitle: "Проект завершён.",
      archiveText: "OTPHub больше не поддерживается и публичная версия приложения недоступна. Исходный код приложения и отдельный репозиторий лендинга остаются открытыми на GitHub.",
      repoLabel: "Исходный код",
      landingLabel: "Лендинг",
      back: "Назад к проектам",
      navAbout: "О проекте",
      navFeatures: "Возможности",
      navAria: "Навигация по проекту OTPHub",
      language: "EN",
      screenshotLabel: "Интерфейс OTPHub",
    },
    en: {
      title: "OTPHub",
      metaTitle: "OTPHub — archived project by Dmitriy Lisin",
      description: "OTPHub — a SwiftUI TOTP and HOTP app for iOS and macOS.",
      eyebrow: "SwiftUI · Security · 2021",
      status: "Archived project",
      lead: "A one-time-password app for iOS and macOS with TOTP/HOTP, QR setup, synchronizable Keychain storage, and backups.",
      storyTitle: "Native 2FA.",
      story: "OTPHub generated TOTP and HOTP codes on iOS and macOS. Accounts supported OTP type, code length, period, and hashing-algorithm configuration. Setup could be imported from standard otpauth:// QR codes, data lived in a synchronizable Keychain, and the database supported backup export and import.",
      periodLabel: "Period",
      period: "2021",
      platformLabel: "Platforms",
      platform: "iOS · macOS",
      stackLabel: "Stack",
      stack: "SwiftUI · Keychain · TOTP/HOTP",
      featuresTitle: "Capabilities.",
      featuresText: "Core workflows implemented in the authenticator.",
      features: [
        ["01", "TOTP & HOTP", "Time-based and counter-based OTP codes with configurable length, period, and hashing algorithm."],
        ["02", "QR onboarding", "Standard otpauth:// QR scanning with automatic account-parameter extraction."],
        ["03", "Keychain sync", "Accounts were stored in a synchronizable Keychain and shared through the app model."],
        ["04", "Backup", "Export and import of a dedicated backup document for moving accounts between devices."],
      ],
      archiveTitle: "Project completed.",
      archiveText: "OTPHub is no longer maintained and the public app is unavailable. The application source and a separate landing-page repository remain available on GitHub.",
      repoLabel: "Source code",
      landingLabel: "Landing",
      back: "Back to projects",
      navAbout: "About",
      navFeatures: "Features",
      navAria: "OTPHub project navigation",
      language: "RU",
      screenshotLabel: "OTPHub interface",
    },
  },
  "covid-dashboard": {
    slug: "covid-dashboard",
    image: covidImage,
    repoUrl: "https://github.com/lisindima/covidshiny",
    landingRepoUrl: null,
    themeClass: "project-covid",
    ru: {
      title: "COVID-19 Dashboard",
      metaTitle: "COVID-19 Dashboard — архивный проект Дмитрия Лисина",
      description: "COVID-19 Dashboard — проект на R и Shiny для моделирования распространения COVID-19 и возможностей системы здравоохранения.",
      eyebrow: "R · Shiny · Plotly · 2021",
      status: "Архивный проект",
      lead: "Интерактивный дашборд для моделирования распространения COVID-19, влияния вмешательств и доступности ресурсов здравоохранения.",
      storyTitle: "Модель эпидемии и ресурсов.",
      story: "Проект разработан в рамках диссертации «Разработка информационной системы моделирования и прогнозирование вирусных заболеваний». Shiny-интерфейс позволяет менять клинические параметры и скорость передачи инфекции, учитывать сезонность, бессимптомную и предсимптоматическую передачу, а результаты отображаются интерактивными графиками Plotly.",
      periodLabel: "Период",
      period: "2021",
      platformLabel: "Формат",
      platform: "Web dashboard",
      stackLabel: "Стек",
      stack: "R · Shiny · Plotly",
      featuresTitle: "Возможности.",
      featuresText: "Основные сценарии моделирования, реализованные в дашборде.",
      features: [
        ["01", "Распространение", "Моделирование динамики восприимчивых, заражённых, выздоровевших и умерших с настройкой клинических параметров."],
        ["02", "Вмешательства", "Настройка периода и силы вмешательств с отдельным снижением передачи для разных стадий инфекции."],
        ["03", "Возможности здравоохранения", "Сравнение прогнозируемых тяжёлых и критических случаев с больничными койками, ICU и доступностью ИВЛ."],
        ["04", "Параметры модели", "Инкубационный период, тяжесть заболевания, смертность, сезонность, бессимптомная и предсимптоматическая передача."],
      ],
      archiveTitle: "Проект завершён.",
      archiveText: "COVID-19 Dashboard больше не поддерживается как публичный сервис. Исходный код модели, Shiny-интерфейс, документация и материалы проекта остаются доступны на GitHub.",
      repoLabel: "Исходный код",
      landingLabel: "Лендинг",
      back: "Назад к проектам",
      navAbout: "О проекте",
      navFeatures: "Возможности",
      navAria: "Навигация по проекту COVID-19 Dashboard",
      language: "EN",
      screenshotLabel: "Интерфейс COVID-19 Dashboard",
    },
    en: {
      title: "COVID-19 Dashboard",
      metaTitle: "COVID-19 Dashboard — archived project by Dmitriy Lisin",
      description: "COVID-19 Dashboard — an R and Shiny project for modeling COVID-19 spread and healthcare capacity.",
      eyebrow: "R · Shiny · Plotly · 2021",
      status: "Archived project",
      lead: "An interactive dashboard for modeling COVID-19 spread, intervention effects, and healthcare-resource capacity.",
      storyTitle: "Epidemic and capacity modeling.",
      story: "The project was developed as part of a dissertation on an information system for modeling and forecasting viral diseases. Its Shiny interface exposes clinical and transmission parameters, seasonality, asymptomatic and presymptomatic transmission, while Plotly renders the resulting simulations as interactive charts.",
      periodLabel: "Period",
      period: "2021",
      platformLabel: "Format",
      platform: "Web dashboard",
      stackLabel: "Stack",
      stack: "R · Shiny · Plotly",
      featuresTitle: "Capabilities.",
      featuresText: "Core simulation workflows implemented in the dashboard.",
      features: [
        ["01", "Spread", "Model susceptible, infected, recovered, and deceased populations with configurable clinical parameters."],
        ["02", "Interventions", "Configure intervention timing and strength with separate transmission reductions for different infection stages."],
        ["03", "Healthcare capacity", "Compare projected severe and critical cases against hospital beds, ICU capacity, and mechanical ventilation."],
        ["04", "Model parameters", "Incubation, disease severity, mortality, seasonality, asymptomatic, and presymptomatic transmission controls."],
      ],
      archiveTitle: "Project completed.",
      archiveText: "COVID-19 Dashboard is no longer maintained as a public service. The model source, Shiny interface, documentation, and project materials remain available on GitHub.",
      repoLabel: "Source code",
      landingLabel: "Landing",
      back: "Back to projects",
      navAbout: "About",
      navFeatures: "Features",
      navAria: "COVID-19 Dashboard project navigation",
      language: "RU",
      screenshotLabel: "COVID-19 Dashboard interface",
    },
  },
} as const;

const item = projects[project];
const copy = item[locale];
const basePath = `/${item.slug}/`;
const localizedPath = `/en/${item.slug}/`;
const canonicalPath = isRu ? basePath : localizedPath;
const alternateHref = isRu ? localizedPath : basePath;
const portfolioHref = isRu ? "/#work" : "/en/#work";
const canonicalHref = `https://lisindmitriy.ru${canonicalPath}`;
const alternateCanonical = `https://lisindmitriy.ru${alternateHref}`;

const navItems = [
  { label: copy.navAbout, href: "#overview" },
  { label: copy.navFeatures, href: "#features" },
  ...(item.repoUrl ? [{ label: "GitHub", href: item.repoUrl, external: true }] : []),
];
---

<!doctype html>
<html lang={locale} transition:name="site-root" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={copy.description} />
    <meta name="theme-color" content="#0b0b0d" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="alternate" hreflang={isRu ? "en" : "ru"} href={alternateCanonical} />
    <link rel="alternate" hreflang="x-default" href={`https://lisindmitriy.ru${basePath}`} />
    <title>{copy.metaTitle}</title>
    <ClientRouter fallback="animate" />
  </head>
  <body class:list={["archive-project", item.themeClass]}>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>

    <SiteHeader
      locale={locale}
      alternateHref={alternateHref}
      languageLabel={copy.language}
      navAria={copy.navAria}
      navItems={navItems}
      navClass="archive-header-nav"
      backHref={portfolioHref}
      backLabel={copy.back}
      brandLabel={copy.title}
      brandHref="#top"
    />

    <main transition:name="site-main" transition:animate={fade({ duration: "0.22s" })}>
      <section id="top" class="archive-hero shell">
        <div class="archive-hero-copy">
          <div class="archive-status-row">
            <span class="archive-status">{copy.status}</span>
            <span class="archive-period">{copy.period}</span>
          </div>
          <p class="eyebrow">{copy.eyebrow}</p>
          <h1>{copy.title}</h1>
          <p class="archive-lead">{copy.lead}</p>
          {(item.repoUrl || item.landingRepoUrl) && (
            <div class="archive-actions">
              {item.repoUrl && (
                <a class="archive-action archive-action-primary" href={item.repoUrl} target="_blank" rel="noreferrer">
                  {copy.repoLabel} <span aria-hidden="true">↗</span>
                </a>
              )}
              {item.landingRepoUrl && (
                <a class="archive-action" href={item.landingRepoUrl} target="_blank" rel="noreferrer">
                  {copy.landingLabel} <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          )}
        </div>
      </section>

      <section class="archive-screenshot shell">
        <figure class="archive-screenshot-media site-lift-card">
          <Image
            src={item.image}
            alt={copy.screenshotLabel}
            widths={[480, 720, 960, 1280, 1600, 1920]}
            sizes="(max-width: 1228px) calc(100vw - 48px), 1180px"
            format="webp"
            quality={82}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <figcaption>{copy.screenshotLabel}</figcaption>
        </figure>
      </section>

      <section id="overview" class="archive-overview shell">
        <article class="archive-story archive-card site-lift-card">
          <p class="archive-card-index">01</p>
          <h2>{copy.storyTitle}</h2>
          <p>{copy.story}</p>
        </article>

        <div class="archive-facts">
          {[
            [copy.periodLabel, copy.period],
            [copy.platformLabel, copy.platform],
            [copy.stackLabel, copy.stack],
          ].map(([label, value], index) => (
            <article class="archive-fact archive-card site-lift-card">
              <span>0{index + 2}</span>
              <p>{label}</p>
              <strong>{value}</strong>
            </article>
          ))}
        </div>
      </section>

      <section id="features" class="archive-features shell">
        <div class="section-intro archive-section-intro">
          <p class="eyebrow">{copy.status}</p>
          <h2>{copy.featuresTitle}</h2>
          <p>{copy.featuresText}</p>
        </div>

        <div class="archive-feature-grid">
          {copy.features.map(([index, title, description]) => (
            <article class="archive-feature archive-card site-lift-card">
              <span>{index}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="archive-closing shell">
        <article class="archive-closing-card site-lift-card">
          <p class="eyebrow">{copy.status}</p>
          <h2>{copy.archiveTitle}</h2>
          <p>{copy.archiveText}</p>
          <div class="archive-closing-actions">
            <a href={portfolioHref}>{copy.back} <span aria-hidden="true">↗</span></a>
            {item.repoUrl && <a href={item.repoUrl} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>}
          </div>
        </article>
      </section>
    </main>

    <footer class="archive-footer shell">
      <span>{isRu ? "Дмитрий Лисин" : "Dmitriy Lisin"}</span>
      <span>{copy.status} · {copy.period}</span>
    </footer>
  </body>
</html>
