---
import "../styles/typography.css";
import "../styles/global.css";
import "../styles/site-ui.css";
import "../styles/project-detail.css";
import { Image } from "astro:assets";
import { ClientRouter, fade } from "astro:transitions";

import SiteHeader from "./SiteHeader.astro";
import favicon from "../assets/favicon.png";
import netliphyImage from "../assets/Netliphy.png";
import otpHubImage from "../assets/OTPHubMac.png";
import covidImage from "../assets/covid.png";

interface Props {
  locale?: "ru" | "en";
  project: "netliphy" | "otphub" | "covid-dashboard";
}

const { locale = "ru", project } = Astro.props;
const isRu = locale === "ru";

const projects = {
  netliphy: {
    slug: "netliphy",
    image: netliphyImage,
    repoUrl: "https://github.com/lisindima/Netliphy",
    landingRepoUrl: "https://github.com/lisindima/NetliphyLanding",
    themeClass: "project-netliphy",
    ru: {
      title: "Netliphy",
      metaTitle: "Netliphy — архивный проект Дмитрия Лисина",
      description: "Архивная страница Netliphy — SwiftUI-клиента для управления сайтами Netlify на iPhone, iPad и Mac.",
      eyebrow: "SwiftUI · Netlify · 2021–2022",
      status: "Архивный проект",
      lead: "Нативный клиент для управления сайтами на Netlify с устройств Apple — от списка сайтов и деплоев до логов, функций, уведомлений и виджета.",
      storyTitle: "Netlify без браузера.",
      story: "Изначальная визитка описывала Netliphy как простой способ управлять Netlify-сайтами с iPhone и iPad: смотреть сайты и команды, контролировать деплои через логи и открывать настройки. В исходниках проект вырос заметно дальше — появились usage, plugins, Functions, forms, environment variables, files, deploy notifications и WidgetKit.",
      periodLabel: "Период",
      period: "2021–2022",
      platformLabel: "Платформы",
      platform: "iPhone · iPad · Mac Catalyst",
      stackLabel: "Стек",
      stack: "SwiftUI · Netlify API · WidgetKit",
      featuresTitle: "Что было внутри.",
      featuresText: "Функции, которые сохранились в исходниках проекта.",
      features: [
        ["01", "Сайты и команды", "Список Netlify-сайтов и команд, профиль аккаунта и детальная информация по каждому сайту."],
        ["02", "Деплои и логи", "История сборок, детали деплоя, действия над ним и просмотр deploy logs."],
        ["03", "Инструменты сайта", "Usage, плагины, Functions, формы, environment variables и файлы — из одного нативного интерфейса."],
        ["04", "Виджет и уведомления", "WidgetKit для статуса последнего деплоя и настраиваемые уведомления по состояниям сборки."],
      ],
      archiveTitle: "Проект завершён, история остаётся.",
      archiveText: "Netliphy больше не поддерживается и публичная версия приложения недоступна. Эта страница сохраняет проект как часть портфолио, а исходный код и старая Jekyll-визитка остаются отдельными репозиториями.",
      repoLabel: "Исходный код",
      landingLabel: "Старая визитка",
      back: "Назад к проектам",
      navAbout: "О проекте",
      navFeatures: "Возможности",
      navAria: "Навигация по проекту Netliphy",
      language: "EN",
      screenshotLabel: "Сохранённый скриншот интерфейса",
    },
    en: {
      title: "Netliphy",
      metaTitle: "Netliphy — archived project by Dmitriy Lisin",
      description: "Archived Netliphy project — a SwiftUI client for managing Netlify sites from iPhone, iPad, and Mac.",
      eyebrow: "SwiftUI · Netlify · 2021–2022",
      status: "Archived project",
      lead: "A native Apple-platform client for managing Netlify sites — from sites and deploys to logs, functions, notifications, and a WidgetKit extension.",
      storyTitle: "Netlify without the browser.",
      story: "The original landing page presented Netliphy as an easy way to manage Netlify-hosted sites from iPhone and iPad: browse sites and teams, monitor deploys through logs, and inspect site settings. The source later grew well beyond that with usage, plugins, Functions, forms, environment variables, files, deploy notifications, and WidgetKit.",
      periodLabel: "Period",
      period: "2021–2022",
      platformLabel: "Platforms",
      platform: "iPhone · iPad · Mac Catalyst",
      stackLabel: "Stack",
      stack: "SwiftUI · Netlify API · WidgetKit",
      featuresTitle: "What was inside.",
      featuresText: "Capabilities preserved in the project source.",
      features: [
        ["01", "Sites & teams", "Browse Netlify sites and teams, account details, and per-site information."],
        ["02", "Deploys & logs", "Build history, deploy details, deploy actions, and deployment logs."],
        ["03", "Site tooling", "Usage, plugins, Functions, forms, environment variables, and files in one native UI."],
        ["04", "Widget & notifications", "A WidgetKit extension for latest deploy status plus configurable deploy notifications."],
      ],
      archiveTitle: "The product ended. The work stays.",
      archiveText: "Netliphy is no longer maintained and the public app is unavailable. This page keeps the project as part of the portfolio while the source code and original Jekyll landing page remain in their own repositories.",
      repoLabel: "Source code",
      landingLabel: "Original landing",
      back: "Back to projects",
      navAbout: "About",
      navFeatures: "Features",
      navAria: "Netliphy project navigation",
      language: "RU",
      screenshotLabel: "Preserved interface screenshot",
    },
  },
  otphub: {
    slug: "otphub",
    image: otpHubImage,
    repoUrl: "https://github.com/lisindima/OTPHub",
    landingRepoUrl: "https://github.com/lisindima/OTPHubLanding",
    themeClass: "project-otphub",
    ru: {
      title: "OTPHub",
      metaTitle: "OTPHub — архивный проект Дмитрия Лисина",
      description: "Архивная страница OTPHub — SwiftUI-приложения для TOTP и HOTP на iOS и macOS.",
      eyebrow: "SwiftUI · Security · 2021",
      status: "Архивный проект",
      lead: "Лёгкий генератор одноразовых паролей для iOS и macOS с TOTP/HOTP, QR-настройкой, синхронизируемым Keychain и резервными копиями.",
      storyTitle: "2FA как нативное приложение.",
      story: "Старая визитка описывала OTPHub как лёгкий генератор одноразовых паролей. Исходники показывают полноценный SwiftUI-клиент для iOS и macOS: TOTP и HOTP, выбор алгоритма и длины кода, сканирование otpauth QR-кодов, хранение аккаунтов в синхронизируемом Keychain и экспорт/импорт резервной копии.",
      periodLabel: "Период",
      period: "2021",
      platformLabel: "Платформы",
      platform: "iOS · macOS",
      stackLabel: "Стек",
      stack: "SwiftUI · Keychain · TOTP/HOTP",
      featuresTitle: "Что было внутри.",
      featuresText: "Небольшой проект, в котором было больше, чем показывала старая визитка.",
      features: [
        ["01", "TOTP и HOTP", "Временные и счётчиковые OTP-коды, настраиваемая длина, период и алгоритм хэширования."],
        ["02", "QR onboarding", "Сканирование стандартных otpauth:// QR-кодов и автоматическое заполнение параметров аккаунта."],
        ["03", "Keychain sync", "Аккаунты хранились в синхронизируемом Keychain и были доступны в общей модели приложения."],
        ["04", "Backup", "Экспорт и импорт собственного backup-файла для переноса аккаунтов между устройствами."],
      ],
      archiveTitle: "Архив вместо мёртвой ссылки.",
      archiveText: "OTPHub больше не поддерживается и публичная версия приложения недоступна. Вместо старого неработающего сайта здесь остаются интерфейс, технический контекст и ссылки на отдельные репозитории приложения и его прежней визитки.",
      repoLabel: "Исходный код",
      landingLabel: "Старая визитка",
      back: "Назад к проектам",
      navAbout: "О проекте",
      navFeatures: "Возможности",
      navAria: "Навигация по проекту OTPHub",
      language: "EN",
      screenshotLabel: "Сохранённый скриншот интерфейса",
    },
    en: {
      title: "OTPHub",
      metaTitle: "OTPHub — archived project by Dmitriy Lisin",
      description: "Archived OTPHub project — a SwiftUI TOTP and HOTP app for iOS and macOS.",
      eyebrow: "SwiftUI · Security · 2021",
      status: "Archived project",
      lead: "A lightweight one-time-password app for iOS and macOS with TOTP/HOTP, QR setup, synchronizable Keychain storage, and backups.",
      storyTitle: "Native 2FA.",
      story: "The original landing page described OTPHub as a lightweight one-time-password generator. The source shows a fuller SwiftUI app for iOS and macOS: TOTP and HOTP, configurable algorithms and code length, otpauth QR scanning, synchronizable Keychain storage, and backup import/export.",
      periodLabel: "Period",
      period: "2021",
      platformLabel: "Platforms",
      platform: "iOS · macOS",
      stackLabel: "Stack",
      stack: "SwiftUI · Keychain · TOTP/HOTP",
      featuresTitle: "What was inside.",
      featuresText: "A small project with more depth than the old landing page showed.",
      features: [
        ["01", "TOTP & HOTP", "Time-based and counter-based OTP codes with configurable length, period, and hashing algorithm."],
        ["02", "QR onboarding", "Standard otpauth:// QR scanning with automatic account-parameter extraction."],
        ["03", "Keychain sync", "Accounts were stored in a synchronizable Keychain and shared through the app model."],
        ["04", "Backup", "Export and import of a dedicated backup document for moving accounts between devices."],
      ],
      archiveTitle: "An archive instead of a dead link.",
      archiveText: "OTPHub is no longer maintained and the public app is unavailable. The old broken website is replaced by this preserved interface, technical context, and links to the separate app and landing-page repositories.",
      repoLabel: "Source code",
      landingLabel: "Original landing",
      back: "Back to projects",
      navAbout: "About",
      navFeatures: "Features",
      navAria: "OTPHub project navigation",
      language: "RU",
      screenshotLabel: "Preserved interface screenshot",
    },
  },
  "covid-dashboard": {
    slug: "covid-dashboard",
    image: covidImage,
    repoUrl: null,
    landingRepoUrl: null,
    themeClass: "project-covid",
    ru: {
      title: "COVID-19 Dashboard",
      metaTitle: "COVID-19 Dashboard — архивный проект Дмитрия Лисина",
      description: "Архивная страница COVID-19 Dashboard — проекта на R и Shiny для моделирования распространения вирусных инфекций и возможностей системы здравоохранения.",
      eyebrow: "R · Shiny · Data · 2021",
      status: "Архивный проект",
      lead: "Веб-дашборд на R и Shiny для моделирования распространения вирусных инфекций и визуализации возможностей системы здравоохранения.",
      storyTitle: "Данные вместо очередного мобильного приложения.",
      story: "Этот проект появился в старой версии портфолио в 2021 году. Сохранившаяся карточка фиксирует его назначение: моделирование распространения вирусных инфекций и возможностей системы здравоохранения. В архиве также остался исходный скриншот интерфейса и стек R + Shiny.",
      periodLabel: "Архив",
      period: "2021",
      platformLabel: "Формат",
      platform: "Web dashboard",
      stackLabel: "Стек",
      stack: "R · Shiny · Data",
      featuresTitle: "Что сохранилось.",
      featuresText: "Для этого проекта я оставляю только то, что подтверждается старой карточкой портфолио.",
      features: [
        ["01", "Моделирование", "Дашборд был посвящён моделированию распространения вирусных инфекций."],
        ["02", "Healthcare capacity", "Вторая часть проекта визуализировала возможности и нагрузку системы здравоохранения."],
        ["03", "R + Shiny", "Интерактивная веб-часть проекта была собрана на R и Shiny."],
      ],
      archiveTitle: "Исходник исчез, кейс — нет.",
      archiveText: "В исторической версии портфолио была ссылка на github.com/lisindima/covidshiny, но сейчас этот публичный репозиторий недоступен. Поэтому здесь нет битой кнопки GitHub: я сохраняю только подтверждённое описание и скриншот проекта.",
      repoLabel: "Исходный код",
      landingLabel: "Старая визитка",
      back: "Назад к проектам",
      navAbout: "О проекте",
      navFeatures: "Архив",
      navAria: "Навигация по проекту COVID-19 Dashboard",
      language: "EN",
      screenshotLabel: "Сохранённый скриншот дашборда",
    },
    en: {
      title: "COVID-19 Dashboard",
      metaTitle: "COVID-19 Dashboard — archived project by Dmitriy Lisin",
      description: "Archived COVID-19 Dashboard — an R and Shiny project for modeling viral spread and healthcare capacity.",
      eyebrow: "R · Shiny · Data · 2021",
      status: "Archived project",
      lead: "An R and Shiny web dashboard for modeling the spread of viral infections and visualizing healthcare capacity.",
      storyTitle: "Data instead of another mobile app.",
      story: "This project appeared in the previous portfolio in 2021. The preserved project card records its purpose: modeling viral infection spread and healthcare capacity. The archive also retains the original interface screenshot and its R + Shiny stack.",
      periodLabel: "Archive",
      period: "2021",
      platformLabel: "Format",
      platform: "Web dashboard",
      stackLabel: "Stack",
      stack: "R · Shiny · Data",
      featuresTitle: "What survived.",
      featuresText: "For this project I keep only the details supported by the old portfolio record.",
      features: [
        ["01", "Modeling", "The dashboard focused on modeling the spread of viral infections."],
        ["02", "Healthcare capacity", "A second part visualized healthcare-system capacity and load."],
        ["03", "R + Shiny", "The interactive web dashboard was built with R and Shiny."],
      ],
      archiveTitle: "The source disappeared. The case study did not.",
      archiveText: "The historical portfolio linked to github.com/lisindima/covidshiny, but that public repository is no longer available. Rather than keep a broken GitHub button, this page preserves only the verified description and project screenshot.",
      repoLabel: "Source code",
      landingLabel: "Original landing",
      back: "Back to projects",
      navAbout: "About",
      navFeatures: "Archive",
      navAria: "COVID-19 Dashboard project navigation",
      language: "RU",
      screenshotLabel: "Preserved dashboard screenshot",
    },
  },
} as const;

const item = projects[project];
const copy = item[locale];
const basePath = `/projects/${item.slug}/`;
const localizedPath = `/en/projects/${item.slug}/`;
const canonicalPath = isRu ? basePath : localizedPath;
const alternateHref = isRu ? localizedPath : basePath;
const portfolioHref = isRu ? "/#work" : "/en/#work";
const canonicalHref = `https://lisindmitriy.ru${canonicalPath}`;
const alternateCanonical = `https://lisindmitriy.ru${alternateHref}`;

const navItems = [
  { label: copy.navAbout, href: "#overview" },
  { label: copy.navFeatures, href: "#features" },
  ...(item.repoUrl ? [{ label: "GitHub", href: item.repoUrl, external: true }] : []),
];
---

<!doctype html>
<html lang={locale} transition:name="site-root" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={copy.description} />
    <meta name="theme-color" content="#0b0b0d" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="alternate" hreflang={isRu ? "en" : "ru"} href={alternateCanonical} />
    <link rel="alternate" hreflang="x-default" href={`https://lisindmitriy.ru${basePath}`} />
    <title>{copy.metaTitle}</title>
    <ClientRouter fallback="animate" />
  </head>
  <body class:list={["archive-project", item.themeClass]}>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>

    <SiteHeader
      locale={locale}
      alternateHref={alternateHref}
      languageLabel={copy.language}
      navAria={copy.navAria}
      navItems={navItems}
      navClass="archive-header-nav"
      backHref={portfolioHref}
      backLabel={copy.back}
      brandLabel={copy.title}
      brandHref="#top"
    />

    <main transition:name="site-main" transition:animate={fade({ duration: "0.22s" })}>
      <section id="top" class="archive-hero shell">
        <div class="archive-hero-copy">
          <div class="archive-status-row">
            <span class="archive-status">{copy.status}</span>
            <span class="archive-period">{copy.period}</span>
          </div>
          <p class="eyebrow">{copy.eyebrow}</p>
          <h1>{copy.title}</h1>
          <p class="archive-lead">{copy.lead}</p>
          {(item.repoUrl || item.landingRepoUrl) && (
            <div class="archive-actions">
              {item.repoUrl && (
                <a class="archive-action archive-action-primary" href={item.repoUrl} target="_blank" rel="noreferrer">
                  {copy.repoLabel} <span aria-hidden="true">↗</span>
                </a>
              )}
              {item.landingRepoUrl && (
                <a class="archive-action" href={item.landingRepoUrl} target="_blank" rel="noreferrer">
                  {copy.landingLabel} <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          )}
        </div>

        <figure class="archive-hero-media site-lift-card">
          <Image
            src={item.image}
            alt={copy.screenshotLabel}
            widths={[480, 720, 960, 1280, 1600]}
            sizes="(max-width: 900px) calc(100vw - 48px), 52vw"
            format="webp"
            quality={78}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <figcaption>{copy.screenshotLabel}</figcaption>
        </figure>
      </section>

      <section id="overview" class="archive-overview shell">
        <article class="archive-story archive-card site-lift-card">
          <p class="archive-card-index">01</p>
          <h2>{copy.storyTitle}</h2>
          <p>{copy.story}</p>
        </article>

        <div class="archive-facts">
          {[
            [copy.periodLabel, copy.period],
            [copy.platformLabel, copy.platform],
            [copy.stackLabel, copy.stack],
          ].map(([label, value], index) => (
            <article class="archive-fact archive-card site-lift-card">
              <span>0{index + 2}</span>
              <p>{label}</p>
              <strong>{value}</strong>
            </article>
          ))}
        </div>
      </section>

      <section id="features" class="archive-features shell">
        <div class="section-intro archive-section-intro">
          <p class="eyebrow">{copy.status}</p>
          <h2>{copy.featuresTitle}</h2>
          <p>{copy.featuresText}</p>
        </div>

        <div class="archive-feature-grid">
          {copy.features.map(([index, title, description]) => (
            <article class="archive-feature archive-card site-lift-card">
              <span>{index}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="archive-closing shell">
        <article class="archive-closing-card site-lift-card">
          <p class="eyebrow">{copy.status}</p>
          <h2>{copy.archiveTitle}</h2>
          <p>{copy.archiveText}</p>
          <div class="archive-closing-actions">
            <a href={portfolioHref}>{copy.back} <span aria-hidden="true">↗</span></a>
            {item.repoUrl && <a href={item.repoUrl} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>}
          </div>
        </article>
      </section>
    </main>

    <footer class="archive-footer shell">
      <span>{isRu ? "Дмитрий Лисин" : "Dmitriy Lisin"}</span>
      <span>{copy.status} · {copy.period}</span>
    </footer>
  </body>
</html>
