---
import "../styles/typography.css";
import "../styles/global.css";
import "../styles/site-ui.css";
import { Image, getImage } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { siteContentTransition, siteFooterTransition } from "../lib/siteTransitions";
import SiteHeader from "./SiteHeader.astro";
import SeoHead from "./SeoHead.astro";

import favicon from "../assets/favicon.png";
import netliphyImage from "../assets/Netliphy.png";
import otpHubImage from "../assets/OTPHubMac.png";
import covidImage from "../assets/covid.png";
import garageImage from "../assets/garage-hero-scene.webp";
import geelyDiagnosticsImage from "../assets/geely-diagnostics.png";

interface Props {
  locale?: "ru" | "en";
}

const { locale = "ru" } = Astro.props;
const isRu = locale === "ru";
const alternateHref = isRu ? "/en/" : "/";
const canonicalHref = isRu ? "https://lisindmitriy.ru/" : "https://lisindmitriy.ru/en/";
const resumeHref = isRu ? "/resume/" : "/en/resume/";

const copy = isRu
  ? {
      title: "Дмитрий Лисин — iOS-разработчик",
      description: "Сайт Дмитрия Лисина — iOS-разработчика, создающего приложения на SwiftUI.",
      language: "EN",
      navWork: "Проекты",
      navContact: "Контакты",
      navAria: "Основная навигация",
      skipToContent: "Перейти к содержимому",
      heroEyebrow: "iOS-разработчик",
      heroRotator: ["SwiftUI", "Swift Concurrency", "iOS Architecture", "Core ML"],
      nameFirst: "Дмитрий",
      nameLast: "Лисин.",
      heroLeadBefore: "Делаю iOS-приложения на",
      heroLeadAfter: "— быстрые, сфокусированные и органичные для платформ Apple.",
      heroAction: "Посмотреть проекты",
      resumeAction: "Резюме",
      emailLabel: "Почта",
      socialAria: "Социальные сети",
      workEyebrow: "Избранные проекты",
      workTitle: "Что я сделал.",
      workText: "Небольшая подборка продуктов и экспериментов для платформ Apple, автомобилей, безопасности и данных.",
      moreWork: "Больше экспериментов — на GitHub",
      contactEyebrow: "Контакты",
      contactTitleA: "Есть интересная",
      contactTitleB: "идея?",
      contactText: "По вопросам проектов можно написать в GitHub. Для всего остального удобнее всего почта.",
      emailAction: "Написать письмо",
      footerLeft: "Дмитрий Лисин",
      footerUpdate: "Обновлено 21 сентября 2026",
      footerSource: "Исходники",
      technologies: "технологии",
      website: "Сайт",
      details: "Подробнее",
      archived: "Архив",
    }
  : {
      title: "Dmitriy Lisin — iOS Developer",
      description: "Personal site of Dmitriy Lisin, iOS developer building apps with SwiftUI.",
      language: "RU",
      navWork: "Work",
      navContact: "Contact",
      navAria: "Main navigation",
      skipToContent: "Skip to content",
      heroEyebrow: "iOS Developer",
      heroRotator: ["SwiftUI", "Swift Concurrency", "iOS Architecture", "Core ML"],
      nameFirst: "Dmitriy",
      nameLast: "Lisin.",
      heroLeadBefore: "I make iOS apps with",
      heroLeadAfter: "— focused, fast, and made to feel at home on Apple platforms.",
      heroAction: "View selected work",
      resumeAction: "Resume",
      emailLabel: "Email",
      socialAria: "Social links",
      workEyebrow: "Selected work",
      workTitle: "Things I’ve built.",
      workText: "A small selection of products and experiments across Apple platforms, automotive, security, and data.",
      moreWork: "More experiments live on GitHub",
      contactEyebrow: "Contact",
      contactTitleA: "Have something",
      contactTitleB: "interesting in mind?",
      contactText: "For project questions, open an issue on GitHub. For everything else, email works best.",
      emailAction: "Send an email",
      footerLeft: "Dmitriy Lisin",
      footerUpdate: "Updated 21 Sep 2026",
      footerSource: "Source",
      technologies: "technologies",
      website: "Website",
      details: "Details",
      archived: "Archived",
    };

const projects = isRu
  ? [
      {
        eyebrow: "SwiftUI · iOS · On-device AI",
        title: "Garage",
        description: "Превращает заказ-наряды в приватную историю обслуживания: сканирует документы, структурирует работы и запчасти, хранит оригиналы и помогает не забывать о следующем ТО — без отправки данных в облако.",
        tags: ["SwiftUI", "Vision", "Core ML"],
        image: garageImage,
        status: null,
        links: [{ label: copy.website, href: "/garage/", external: false }],
      },
      {
        eyebrow: "Android Automotive · Geely",
        title: "Geely Diagnostics",
        description: "Исследовательское read-only приложение для штатных ГУ Geely: диагностика ECU/OBD2 и live-данные через ECARX AdaptAPI и Android Automotive VHAL.",
        tags: ["Kotlin", "Compose", "VHAL"],
        image: geelyDiagnosticsImage,
        status: null,
        links: [
          { label: "GitHub", href: "https://github.com/lisindima/GeelyDiagnostics", external: true },
        ],
      },
      {
        eyebrow: "SwiftUI · iOS · macOS",
        title: "Netliphy",
        description: "Управление сайтами на Netlify с iPhone, iPad и Mac в нативном интерфейсе для платформ Apple.",
        tags: ["SwiftUI", "Netlify", "WidgetKit"],
        image: netliphyImage,
        status: copy.archived,
        links: [
          { label: copy.details, href: "/netliphy/", external: false },
          { label: "GitHub", href: "https://github.com/lisindima/Netliphy", external: true },
        ],
      },
      {
        eyebrow: "Безопасность · SwiftUI",
        title: "OTPHub",
        description: "Лёгкое приложение для одноразовых паролей и безопасной аутентификации по алгоритмам TOTP и HOTP.",
        tags: ["SwiftUI", "TOTP", "HOTP"],
        image: otpHubImage,
        status: copy.archived,
        links: [
          { label: copy.details, href: "/otphub/", external: false },
          { label: "GitHub", href: "https://github.com/lisindima/OTPHub", external: true },
        ],
      },
      {
        eyebrow: "Данные · Здравоохранение",
        title: "COVID-19 Dashboard",
        description: "Дашборд для моделирования распространения вируса и визуализации нагрузки на систему здравоохранения.",
        tags: ["R", "Shiny", "Plotly"],
        image: covidImage,
        status: copy.archived,
        links: [
          { label: copy.details, href: "/covid-dashboard/", external: false },
          { label: "GitHub", href: "https://github.com/lisindima/covidshiny", external: true },
        ],
      },
    ]
  : [
      {
        eyebrow: "SwiftUI · iOS · On-device AI",
        title: "Garage",
        description: "Turn service orders into a private car maintenance history — scan documents, structure work and parts, keep originals, and track future service without sending data to the cloud.",
        tags: ["SwiftUI", "Vision", "Core ML"],
        image: garageImage,
        status: null,
        links: [{ label: copy.website, href: "/garage/en/", external: false }],
      },
      {
        eyebrow: "Android Automotive · Geely",
        title: "Geely Diagnostics",
        description: "A read-only research app for Geely head units: ECU/OBD2 diagnostics and live vehicle data through ECARX AdaptAPI and Android Automotive VHAL.",
        tags: ["Kotlin", "Compose", "VHAL"],
        image: geelyDiagnosticsImage,
        status: null,
        links: [
          { label: "GitHub", href: "https://github.com/lisindima/GeelyDiagnostics", external: true },
        ],
      },
      {
        eyebrow: "SwiftUI · iOS · macOS",
        title: "Netliphy",
        description: "Manage Netlify-hosted sites from iPhone, iPad, and Mac with a native Apple-platform experience.",
        tags: ["SwiftUI", "Netlify", "WidgetKit"],
        image: netliphyImage,
        status: copy.archived,
        links: [
          { label: copy.details, href: "/en/netliphy/", external: false },
          { label: "GitHub", href: "https://github.com/lisindima/Netliphy", external: true },
        ],
      },
      {
        eyebrow: "Security · SwiftUI",
        title: "OTPHub",
        description: "A lightweight one-time password app for secure authentication using TOTP and HOTP algorithms.",
        tags: ["SwiftUI", "TOTP", "HOTP"],
        image: otpHubImage,
        status: copy.archived,
        links: [
          { label: copy.details, href: "/en/otphub/", external: false },
          { label: "GitHub", href: "https://github.com/lisindima/OTPHub", external: true },
        ],
      },
      {
        eyebrow: "Data · Healthcare",
        title: "COVID-19 Dashboard",
        description: "A dashboard for modeling viral spread and visualizing healthcare capacity.",
        tags: ["R", "Shiny", "Plotly"],
        image: covidImage,
        status: copy.archived,
        links: [
          { label: copy.details, href: "/en/covid-dashboard/", external: false },
          { label: "GitHub", href: "https://github.com/lisindima/covidshiny", external: true },
        ],
      },
    ];

const socialLinks = [
  { label: "GitHub", href: "https://github.com/lisindima" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/lisindmitriy/" },
  { label: "X", href: "https://twitter.com/lisindima" },
];

const socialImage = await getImage({
  src: garageImage,
  width: 1200,
  format: "webp",
  quality: 82,
});

const faviconImage = await getImage({
  src: favicon,
  width: 64,
  format: "png",
});

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Dmitriy Lisin",
  url: "https://lisindmitriy.ru/",
  jobTitle: "iOS Developer",
  sameAs: socialLinks.map((link) => link.href),
  knowsAbout: ["iOS", "Swift", "SwiftUI"],
};
---

<!doctype html>
<html lang={locale} transition:name="site-root" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead
      title={copy.title}
      description={copy.description}
      canonical={canonicalHref}
      locale={locale}
      alternates={[
        { hreflang: "ru", href: "https://lisindmitriy.ru/" },
        { hreflang: "en", href: "https://lisindmitriy.ru/en/" },
        { hreflang: "x-default", href: "https://lisindmitriy.ru/" },
      ]}
      image={socialImage.src}
      schema={schema}
    />
    <meta name="theme-color" content="#f7f7f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href={faviconImage.src} />
    <title>{copy.title}</title>
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skipToContent}</a>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>

    <SiteHeader
      locale={locale}
      alternateHref={alternateHref}
      languageLabel={copy.language}
      navAria={copy.navAria}
      navItems={[
        { label: copy.navWork, href: "#work" },
        { label: copy.navContact, href: "#contact", className: "nav-contact" },
        { label: copy.resumeAction, href: resumeHref, className: "nav-resume" },
        { label: "GitHub", href: "https://github.com/lisindima", external: true, className: "nav-github" },
      ]}
    />

    <main id="main-content" transition:name="site-main" transition:animate={siteContentTransition()}>
      <section id="hero" class="hero shell">
        <div class="hero-copy">
          <p class="eyebrow hero-eyebrow">
            <span class="status-dot" aria-hidden="true"></span>
            <span>{copy.heroEyebrow}</span>
            <span aria-hidden="true">·</span>
            <span class="hero-rotator" aria-hidden="true">
              {copy.heroRotator.map((word) => <span>{word}</span>)}
            </span>
          </p>
          <h1>{copy.nameFirst}<br />{copy.nameLast}</h1>
          <p class="hero-lead">{copy.heroLeadBefore} <strong>SwiftUI</strong> {copy.heroLeadAfter}</p>
          <div class="hero-actions">
            <a class="primary-action" href="#work">{copy.heroAction} <span aria-hidden="true">↓</span></a>
            <a class="secondary-action" href={resumeHref}>{copy.resumeAction} <span aria-hidden="true">↗</span></a>
          </div>
          <div class="hero-socials" aria-label={copy.socialAria}>
            <a href="mailto:me@lisindmitriy.ru">{copy.emailLabel} <span aria-hidden="true">↗</span></a>
            {socialLinks.map((link) => (
              <a href={link.href} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>
            ))}
          </div>
        </div>
      </section>

      <section id="work" class="work-section shell">
        <div class="section-intro">
          <p class="eyebrow">{copy.workEyebrow}</p>
          <h2>{copy.workTitle}</h2>
          <p>{copy.workText}</p>
        </div>

        <div class="projects-bento">
          {projects.map((project, index) => (
            <article
              class:list={[
                "project-card",
                "site-lift-card",
                {
                  featured: index === 0,
                  "project-card-geely": project.title === "Geely Diagnostics",
                },
              ]}
            >
              <div class="project-media">
                <Image
                  src={project.image}
                  alt=""
                  widths={[320, 480, 640, 800, 960]}
                  sizes={index === 0 ? "(max-width: 900px) calc(100vw - 40px), 720px" : "(max-width: 900px) calc(100vw - 40px), 480px"}
                  format="webp"
                  quality={70}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="project-info">
                <div class="project-kicker-row">
                  <p class="project-eyebrow">{project.eyebrow}</p>
                  {project.status && <span class="project-status">{project.status}</span>}
                </div>
                <div class="project-title-row">
                  <h3>{project.title}</h3>
                  <span class="project-number">0{index + 1}</span>
                </div>
                <p class="project-description">{project.description}</p>
                <ul class="tags" aria-label={`${project.title} ${copy.technologies}`}>
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
                <div class="project-links">
                  {project.links.map((link) => (
                    <a
                      href={link.href}
                      target={link.external ? "_blank" : undefined}
                      rel={link.external ? "noreferrer" : undefined}
                    >{link.label} <span aria-hidden="true">↗</span></a>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>

        <a class="more-work" href="https://github.com/lisindima" target="_blank" rel="noreferrer">
          <span>{copy.moreWork}</span>
          <strong aria-hidden="true">↗</strong>
        </a>
      </section>

      <section id="contact" class="contact-section shell">
        <div class="contact-panel">
          <p class="eyebrow">{copy.contactEyebrow}</p>
          <h2>{copy.contactTitleA}<br />{copy.contactTitleB}</h2>
          <p>{copy.contactText}</p>
          <div class="contact-links">
            <a class="primary-action" href="mailto:me@lisindmitriy.ru">{copy.emailAction} <span aria-hidden="true">↗</span></a>
            <a class="secondary-action" href="https://github.com/lisindima" target="_blank" rel="noreferrer">GitHub</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer site-footer-with-changelog shell" transition:name="site-footer" transition:animate={siteFooterTransition()}>
      <span>© {new Date().getFullYear()} {copy.footerLeft}</span>
      <span class="site-footer-changelog"><strong>{copy.footerUpdate}</strong></span>
      <a class="site-footer-source" href="https://github.com/lisindima/lisindmitriy.me" target="_blank" rel="noreferrer">
        {copy.footerSource} <span aria-hidden="true">↗</span>
      </a>
    </footer>
  </body>
</html>
