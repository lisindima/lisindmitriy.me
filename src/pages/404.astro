---
import "../styles/typography.css";
import "../styles/global.css";
import "../styles/site-ui.css";
import { ClientRouter } from "astro:transitions";
import { siteContentTransition } from "../lib/siteTransitions";
import { getImage } from "astro:assets";
import favicon from "../assets/favicon.png";
import SiteHeader from "../components/SiteHeader.astro";

const faviconImage = await getImage({ src: favicon, width: 64, format: "png" });
---

<!doctype html>
<html lang="ru" transition:name="site-root" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Запрошенная страница не найдена." />
    <meta name="theme-color" content="#f7f7f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href={faviconImage.src} />
    <title>404 — страница не найдена</title>
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Перейти к содержимому</a>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>

    <SiteHeader
      locale="ru"
      alternateHref="/en/"
      languageLabel="EN"
      navAria="Навигация страницы 404"
      navItems={[]}
      backHref="/"
      backLabel="На главную"
      brandLabel="Dmitriy Lisin"
      brandHref="/"
    />

    <main id="main-content" transition:name="site-main" transition:animate={siteContentTransition()} class="not-found-page shell">
      <div class="not-found-copy">
        <p class="eyebrow">Ошибка 404</p>
        <h1>Страница не найдена.</h1>
        <p>Возможно, ссылка устарела или адрес набран с ошибкой. Все актуальные проекты доступны на главной странице.</p>
        <a class="primary-action" href="/">Вернуться на главную <span aria-hidden="true">↗</span></a>
      </div>
    </main>
  </body>
</html>
